# GEMINI_API_KEY: Required for the AI Mentor chat, Gemini TTS voices and grounded web search.
# Without it, the app still runs: live RSS news works, search falls back to Google News RSS,
# and voice falls back to the browser's speech synthesis.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model overrides (defaults shown)
# GEMINI_CHAT_MODEL="gemini-2.5-flash"
# GEMINI_SEARCH_MODEL="gemini-2.5-flash"
# GEMINI_TTS_MODELS="gemini-2.5-flash-preview-tts,gemini-2.5-pro-preview-tts"

# PORT: HTTP port for the Express server (default 3000)
# PORT=3000
